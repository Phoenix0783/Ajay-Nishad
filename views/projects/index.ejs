
<%- include('../partials/header') %>

<section class="page-intro">
  <p class="eyebrow">MY WORK &amp; EXPERIMENTS</p>
  <h1>Selected <span class="accent">Projects.</span></h1>
  <p>
    A collection of UI/UX designs and web development projects
    that showcase my skills, creativity and problem-solving approach.
  </p>
</section>

<div class="filter-list" aria-label="Filter projects">
  <button class="filter-btn active" data-filter="all">All</button>
  <button class="filter-btn" data-filter="UI/UX Design">UI/UX</button>
  <button class="filter-btn" data-filter="Full Stack Development">
    Full Stack Development
  </button>
</div>

<div class="project-grid projects-page-grid">
  <% projects.forEach(project => { %>
    <article class="project-card"
             data-category="<%= project.category %>">
      <a href="/projects/<%= project.slug %>" class="project-image-link">
        <img src="<%= project.image %>" alt="<%= project.title %> preview"
             class="project-image" loading="lazy">
      </a>

      <div class="project-card-body">
        <span class="project-category"><%= project.category %></span>
        <h2><a href="/projects/<%= project.slug %>"><%= project.title %></a></h2>
        <p><%= project.description %></p>

        <div class="tag-list compact-tags">
          <% project.tags.forEach(tag => { %>
            <span><%= tag %></span>
          <% }) %>
        </div>

        <a class="text-link" href="/projects/<%= project.slug %>">
          View Project →
        </a>
      </div>
    </article>
  <% }) %>
</div>

<div class="center-action">
  <a class="btn btn-outline" href="/">← Back to Home</a>
</div>

<%- include('../partials/footer') %>
