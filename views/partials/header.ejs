
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F1F1EE">
  <meta name="description" content="Portfolio of a UI/UX Designer and Full Stack Developer.">
  <title><%= title %> | Ajay Nishad</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>
    try {
      var savedTheme = localStorage.getItem('portfolio-theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.dataset.theme = savedTheme;
      }
    } catch (error) {
      console.warn('Theme preference could not be loaded.', error);
    }
  </script>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Ajay Nishad home">
      AJAY NISHAD
    </a>

    <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button"
            aria-label="Open navigation menu" aria-expanded="false"
            aria-controls="main-navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <button class="nav-overlay" id="nav-overlay" type="button"
            aria-label="Close navigation menu" tabindex="-1"></button>

    <nav class="main-nav" id="main-navigation" aria-label="Main navigation">
      <a href="/#about">About</a>
      <a href="/#skills">Skills</a>
      <a href="/projects"
         class="<%= title === 'Projects' ? 'active' : '' %>">
        Projects
      </a>
      <a href="/#experience">Experience</a>
      <a href="/#contact">Contact</a>
    </nav>

    <button class="theme-toggle" id="theme-toggle" type="button"
            aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"/>
      </svg>
      <span class="theme-toggle-label">Dark mode</span>
    </button>
  </header>

  <main class="page-shell">
