<section class="section" id="projects">
  <div class="section-heading">
    <div>
      <p class="eyebrow">SELECTED WORK</p>
      <h2>Featured projects<span class="accent">.</span></h2>
    </div>
    <a class="text-link" href="/projects">View all projects ↗</a>
  </div>

  <div class="project-grid">
    <% projects.slice(0, 3).forEach(project => { %>
      <article class="project-card">
        <a href="/projects/<%= project.slug %>" class="project-image-link">
          <img src="<%= project.image %>" alt="<%= project.title %> preview"
               class="project-image" loading="lazy">
        </a>

        <div class="project-card-body">
          <span class="project-category"><%= project.category %></span>
          <h3><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
          <p><%= project.description %></p>

          <div class="tag-list compact-tags">
            <% project.tags.slice(0, 3).forEach(tag => { %>
              <span><%= tag %></span>
            <% }) %>
          </div>

          <a class="text-link" href="/projects/<%= project.slug %>">
            View Project <span>→</span>
          </a>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section" id="experience">
  <div class="section-heading">
    <div>
      <p class="eyebrow">MY JOURNEY</p>
      <h2>Experience<span class="accent">.</span></h2>
    </div>
  </div>

  <div class="timeline">
    <% experience.forEach(item => { %>
      <article class="timeline-item">
        <span class="timeline-dot"></span>
        <div class="timeline-date"><%= item.period %></div>
        <div class="timeline-content">
          <h3><%= item.title %></h3>
          <% if (item.company) { %>
            <p class="timeline-company"><%= item.company %></p>
          <% } %>
          <ul>
            <% item.points.forEach(point => { %>
              <li><%= point %></li>
            <% }) %>
          </ul>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section contact-section" id="contact">
  <div class="contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">HAVE A PROJECT IN MIND?</p>
      <h2>Let's work<br>together<span class="accent">.</span></h2>
      <p>
        Have an opportunity, an idea or just want to connect?
        I'd be happy to hear from you.
      </p>
      <a class="text-link" href="mailto:nishadajay1099@gmail.com">
        nishadajay1099@gmail.com ↗
      </a>
    </div>

    <form class="contact-form" id="contact-form"
          action="https://formspree.io/f/maeqvwgo" method="POST">
      <label for="name">Your name</label>
      <input id="name" name="name" type="text"
             placeholder="Enter your name" required>

      <label for="email">Email address</label>
      <input id="email" name="_replyto" type="email"
             placeholder="you@example.com" required>

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="4"
                placeholder="Tell me about your project..." required></textarea>

      <button class="btn btn-primary" type="submit" id="contact-submit">
        Send Message ↗
      </button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
